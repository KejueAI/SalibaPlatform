# Database (managed PostgreSQL — Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:pass@host:5432/saliba

# Auth
BETTER_AUTH_SECRET=   # REQUIRED: openssl rand -base64 32
BETTER_AUTH_URL=https://saliba.kejue.co
ADMIN_EMAIL=admin@kejue.co
ADMIN_PASSWORD=       # Set a strong password, used only for initial seed

# Apify (Instagram scraping)
APIFY_TOKEN=          # Get from https://console.apify.com/account/integrations

# LLM (generic OpenAI-compatible — swap provider by changing these 3)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Voice Agent Tool — MUST be a strong random value in production
# Generate with: openssl rand -hex 32
TOOL_API_KEY=

# vAuto upload directory (configured at OS level)
VAUTO_UPLOAD_DIR=/home/vauto/uploads
